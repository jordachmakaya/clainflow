
{
  "name": "express-api-template",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",

    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "test:all": "turbo run test",
    "typecheck:all": "turbo run typecheck",
    "lint:all": "turbo run lint",

    "test:infra": "pnpm --filter infra test",
    "synth:infra": "pnpm --filter infra synth",

    "env:sync": "env-sync --provider=github --env-file=.env.production --sync-only",
    "env:sync:dry": "env-sync --provider=github --env-file=.env.production --sync-only --dry-run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@hardmachinelabs/zod-config": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hardmachinelabs/env-sync": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "prettier": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
