{
  "name": "express-api-template",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:sync": "env-sync --provider=github --env-file=.env.production --sync-only",
    "env:sync:dry": "env-sync --provider=github --env-file=.env.production --sync-only --dry-run"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "@hardmachinelabs/zod-config": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hardmachinelabs/env-sync": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "prettier": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}