{
  "name": "express-api-template",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:sync": "env-sync --provider=github --env-file=.env.production --sync-only",
    "env:sync:dry": "env-sync --provider=github --env-file=.env.production --sync-only --dry-run"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "@hardmachinelabs/zod-config": "^0.2.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hardmachinelabs/env-sync": "^1.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}